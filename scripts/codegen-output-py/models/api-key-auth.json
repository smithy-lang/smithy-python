                },
                "smithy.protocols#rpcv2Cbor": {}
            }
        },
        "example.apikey#GetThing": {
            "type": "operation",
            "input": {
                "target": "example.apikey#GetThingInput"
            },
            "output": {
                "target": "example.apikey#GetThingOutput"
            },
            "traits": {
                "smithy.api#documentation": "Uses the service's API key auth."
            }
        },
        "example.apikey#GetThingInput": {
            "type": "structure",
            "members": {
                "name": {
                    "target": "smithy.api#String"
                }
            },
