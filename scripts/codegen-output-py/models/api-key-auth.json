                "smithy.api#input": {}
            }
        },
        "example.apikey#GetThingOutput": {
            "type": "structure",
            "members": {
                "value": {
                    "target": "smithy.api#String"
                }
            },
            "traits": {
                "smithy.api#output": {}
            }
        },
        "example.apikey#Health": {
            "type": "operation",
            "input": {
                "target": "smithy.api#Unit"
            },
            "output": {
                "target": "smithy.api#Unit"
            },
            "traits": {
                "smithy.api#auth": [],
                "smithy.api#documentation": "Needs no auth."
            }
        },
        "example.apikey#Ping": {
            "type": "operation",
            "input": {
                "target": "smithy.api#Unit"
            },
            "output": {
                "target": "smithy.api#Unit"
            },
            "traits": {
                "smithy.api#documentation": "Sends the API key when it has one.",
