    "smithy.test#HttpRequestMixin": {
      "type": "structure",
      "mixins": [
        {
          "target": "smithy.test#HttpMessageMixin"
        }
      ],
      "members": {
        "method": {
          "target": "smithy.api#String",
          "traits": {
