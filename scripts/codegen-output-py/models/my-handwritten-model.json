        "smithy.waiters#waitable": {
          "ItemReady": {
            "documentation": "Waits until the item is ready.",
            "minDelay": 1,
            "maxDelay": 5,
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "output": {
                    "path": "status",
                    "expected": "READY",
                    "comparator": "stringEquals"
                  }
                }
              },
              {
                "state": "failure",
                "matcher": {
                  "output": {
                    "path": "status",
                    "expected": "FAILED",
                    "comparator": "stringEquals"
                  }
                },
                "message": "reason"
              },
              {
                "state": "retry",
                "matcher": {
                  "errorType": "ItemNotFound"
                }
              }
            ]
          },
          "ItemDeleted": {
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "errorType": "ItemNotFound"
                }
              }
            ]
          }
        }
      }
    },
