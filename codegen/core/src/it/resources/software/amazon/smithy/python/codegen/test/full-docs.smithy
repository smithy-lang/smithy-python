$version: "2.0"

namespace example.docs

use aws.protocols#restJson1

/// Grants and watches temporary access.
@restJson1
service DocsService {
    version: "2026-11-11"
    operations: [AssumeAccess, MigrateSession, UploadDocument, WatchAccess]
}

/// Returns temporary access for a session.
///
/// Access is revoked when the session ends.
@http(method: "POST", uri: "/access")
operation AssumeAccess {
    input := {
        /// The duration of the session, in seconds. A session costs $5 per hour
        /// and its duration can range from 900 seconds up to the maximum that is
        /// set for the role.
        ///
        /// <important>
        /// Never share the session with an untrusted party. Chained sessions
        /// are limited to one hour.
        /// </important>
        ///
        /// - Compute the default as 2 * 3 * 600 seconds.
        /// - Quote the unit as `"""seconds"""` in `C:\dir\session.ini`.
        @required
        durationSeconds: Integer

        /// The names of the plugins to enable for the session.
        plugins: PluginNames

        /// A tag to attach to the session.
        tag: SessionTag

        /// Where the caller's credentials come from.
        source: CredentialSource

        /// - `fast` skips the audit trail.
        /// - `safe` records every call.
        mode: String

        undocumented: String

        // Not documented either, but the client fills it, which is said wherever
        // the member is documented.
        @idempotencyToken
        clientToken: String
    }

    output := {
        /// The granted session.
        sessionId: String
    }
}

// The paths and account names below are spelled as the Storage Gateway and
// WorkSpaces models spell them. Each has a backslash that Python or Markdown
// could take for the start of an escape.

/// Migrates a session to another host, which costs $5 for each `$LATEST`
/// version. During migration, the original `D:\Users\%USERNAME%` user
/// profile folder is renamed to
/// `D:\Users\%USERNAME%MMddyyTHHmmss%.NotMigrated`. A new
/// `D:\Users\%USERNAME%\` folder is generated by the new OS.
@http(method: "POST", uri: "/migrate")
operation MigrateSession {
    input := {
        /// The user or group that administers the migrated session. Acceptable
        /// formats include: `DOMAIN\User1`, `user@domain`, `@group1`, and
        /// `@DOMAIN\group1`.
        ///
        /// <important>
        /// Use this option very carefully, because this user can do anything
        /// they like on the session, regardless of its permissions.
        /// </important>
        admin: String
    }
}

/// Stores a document for a session.
@idempotent
@http(method: "PUT", uri: "/documents/{name}")
operation UploadDocument {
    input := {
        /// The name of the document.
        @required
        @httpLabel
        name: String

        /// The bytes of the document.
        @required
        @httpPayload
        body: DocumentData
    }
}

/// Reports on a session while it is watched.
@http(method: "POST", uri: "/watch/{sessionId}")
operation WatchAccess {
    input := {
        /// The session to watch.
        @required
        @httpLabel
        sessionId: String

        /// The events the caller sends.
        @required
        @httpPayload
        events: WatchEvents
    }
}

/// A key and value attached to a session.
structure SessionTag {
    /// The key of the tag. Keys are case sensitive.
    ///
    /// Keys that start with `aws:` are reserved.
    @required
    key: String

    /// The value of the tag.
    value: String
}

/// How the caller is identified.
union CredentialSource {
    /// A web identity token issued by the provider.
    webToken: String

    /// A stored profile to read credentials from.
    profile: SessionTag
}

list PluginNames {
    member: String
}

@streaming
blob DocumentData

@streaming
union WatchEvents {
    ping: PingEvent
}

structure PingEvent {
    @required
    sequence: Integer
}
